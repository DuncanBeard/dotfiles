{{- $email := promptStringOnce . "email" "Email address" -}}
{{- $optionalApps := promptBoolOnce . "optionalApps" "Install optional apps (Dropbox, Insta360 Link Controller, Logseq, PowerToys)" -}}

[data]
    email = {{ $email | quote }}
    optionalApps = {{ $optionalApps }}

[edit]
    command = "code"

[diff]
command = "code"
args = ["--wait", "--diff"]

[merge]
{{ if eq .chezmoi.os "darwin" -}}
command = "code"
args = ["--wait", "--merge"]
{{ end -}}
