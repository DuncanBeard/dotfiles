{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash

# brews/casks are optional in packages.yaml; --no-lock was removed from Homebrew.
brew bundle --file=/dev/stdin <<EOF
{{ range (dig "brews" (list) .packages.darwin) -}}
brew {{ . | quote }}
{{ end -}}
{{ range (dig "casks" (list) .packages.darwin) -}}
cask {{ . | quote }}
{{ end -}}
EOF
{{ end -}}
