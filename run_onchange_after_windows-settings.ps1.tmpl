{{ if eq .chezmoi.os "windows" -}}
$ErrorActionPreference = 'Stop'

$advanced = 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced'
$search = 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Search'
$personalize = 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Themes\Personalize'
$mouse = 'HKCU:\Control Panel\Mouse'
$desktopIcons = 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\HideDesktopIcons\NewStartPanel'
$thisPC = '{20D04FE0-3AEA-1069-A2D8-08002B30309D}'

$settings = @(
  # Mouse acceleration ("Enhance pointer precision") off
  @{ Path = $mouse; Name = 'MouseSpeed'; Value = '0'; Type = 'String'; Applies = 'Mouse' }
  @{ Path = $mouse; Name = 'MouseThreshold1'; Value = '0'; Type = 'String'; Applies = 'Mouse' }
  @{ Path = $mouse; Name = 'MouseThreshold2'; Value = '0'; Type = 'String'; Applies = 'Mouse' }

  # Snap: don't show what can be snapped next to a window
  @{ Path = $advanced; Name = 'SnapAssist'; Value = 0; Type = 'DWord'; Applies = 'Explorer' }
  # Alt+Tab: open windows only, no Edge tabs
  @{ Path = $advanced; Name = 'MultiTaskingAltTabFilter'; Value = 3; Type = 'DWord'; Applies = 'Explorer' }

  # Taskbar: left aligned, small bar, small buttons, never combine, no Task View or search
  @{ Path = $advanced; Name = 'TaskbarAl'; Value = 0; Type = 'DWord'; Applies = 'Explorer' }
  @{ Path = $advanced; Name = 'TaskbarSize'; Value = 1; Type = 'DWord'; Applies = 'Explorer' }
  @{ Path = $advanced; Name = 'IconSizePreference'; Value = 0; Type = 'DWord'; Applies = 'Explorer' }
  @{ Path = $advanced; Name = 'TaskbarGlomLevel'; Value = 2; Type = 'DWord'; Applies = 'Explorer' }
  @{ Path = $advanced; Name = 'MMTaskbarGlomLevel'; Value = 2; Type = 'DWord'; Applies = 'Explorer' }
  @{ Path = $advanced; Name = 'ShowTaskViewButton'; Value = 0; Type = 'DWord'; Applies = 'Explorer' }
  @{ Path = $search; Name = 'SearchboxTaskbarMode'; Value = 0; Type = 'DWord'; Applies = 'Explorer' }

  # Desktop: show This PC
  @{ Path = $desktopIcons; Name = $thisPC; Value = 0; Type = 'DWord'; Applies = 'Explorer' }

  # Dark mode, transparency off
  @{ Path = $personalize; Name = 'AppsUseLightTheme'; Value = 0; Type = 'DWord'; Applies = 'Explorer' }
  @{ Path = $personalize; Name = 'SystemUsesLightTheme'; Value = 0; Type = 'DWord'; Applies = 'Explorer' }
  @{ Path = $personalize; Name = 'EnableTransparency'; Value = 0; Type = 'DWord'; Applies = 'Explorer' }
)

$changed = [System.Collections.Generic.HashSet[string]]::new()
foreach ($setting in $settings) {
  $current = (Get-ItemProperty -Path $setting.Path -Name $setting.Name -ErrorAction SilentlyContinue).($setting.Name)
  if ($null -ne $current -and "$current" -eq "$($setting.Value)") {
    continue
  }
  if (-not (Test-Path -Path $setting.Path)) {
    New-Item -Path $setting.Path -Force | Out-Null
  }
  Write-Host "Setting $($setting.Name) to $($setting.Value)"
  Set-ItemProperty -Path $setting.Path -Name $setting.Name -Value $setting.Value -Type $setting.Type
  [void]$changed.Add($setting.Applies)
}

if ($changed.Contains('Mouse')) {
  if (-not ('ChezmoiWindowsSettings.Native' -as [type])) {
    Add-Type -Namespace ChezmoiWindowsSettings -Name Native -MemberDefinition @'
[DllImport("user32.dll", SetLastError = true)]
public static extern bool SystemParametersInfo(uint action, uint param, int[] values, uint winIni);
'@
  }
  # SPI_SETMOUSE, persisted and broadcast so the change applies without signing out.
  $mouseValues = [int[]]@(0, 0, 0)
  if (-not [ChezmoiWindowsSettings.Native]::SystemParametersInfo(0x0004, 0, $mouseValues, 0x03)) {
    Write-Warning 'Mouse settings were saved but could not be applied until the next sign-in.'
  }
}

if ($changed.Contains('Explorer')) {
  Write-Host 'Restarting Explorer to apply taskbar and theme settings'
  Stop-Process -Name explorer -Force -ErrorAction SilentlyContinue
  Start-Sleep -Seconds 2
  if (-not (Get-Process -Name explorer -ErrorAction SilentlyContinue)) {
    Start-Process explorer.exe
  }
}
# Desktop: auto arrange icons, sorted by name. Explorer keeps desktop view state in
# memory and overwrites the registry, so apply it through the live desktop view.
if (-not ('ChezmoiWindowsSettings.Desktop' -as [type])) {
  Add-Type -TypeDefinition @'
using System;
using System.Reflection;
using System.Runtime.InteropServices;

namespace ChezmoiWindowsSettings {
  [ComImport, Guid("6D5140C1-7436-11CE-8034-00AA006009FA"), InterfaceType(ComInterfaceType.InterfaceIsIUnknown)]
  interface IServiceProvider {
    [return: MarshalAs(UnmanagedType.IUnknown)]
    object QueryService(ref Guid service, ref Guid riid);
  }

  [ComImport, Guid("000214E2-0000-0000-C000-000000000046"), InterfaceType(ComInterfaceType.InterfaceIsIUnknown)]
  interface IShellBrowser {
    void GetWindow(); void ContextSensitiveHelp(); void InsertMenusSB(); void SetMenuSB(); void RemoveMenusSB();
    void SetStatusTextSB(); void EnableModelessSB(); void TranslateAcceleratorSB(); void BrowseObject();
    void GetViewStateStream(); void GetControlWindow(); void SendControlMsg();
    [return: MarshalAs(UnmanagedType.IUnknown)]
    object QueryActiveShellView();
  }

  [ComImport, Guid("000214E3-0000-0000-C000-000000000046"), InterfaceType(ComInterfaceType.InterfaceIsIUnknown)]
  interface IShellView {
    void GetWindow(); void ContextSensitiveHelp(); void TranslateAccelerator(); void EnableModeless(); void UIActivate();
    void Refresh(); void CreateViewWindow(); void DestroyViewWindow(); void GetCurrentInfo(); void AddPropertySheetPages();
    void SaveViewState();
  }

  [StructLayout(LayoutKind.Sequential)]
  public struct PropertyKey { public Guid FormatId; public uint PropertyId; }

  [StructLayout(LayoutKind.Sequential)]
  public struct SortColumn { public PropertyKey Key; public int Direction; }

  [ComImport, Guid("1af3a467-214f-4298-908e-06b03e0b39f9"), InterfaceType(ComInterfaceType.InterfaceIsIUnknown)]
  interface IFolderView2 {
    // IFolderView
    void GetCurrentViewMode(); void SetCurrentViewMode(); void GetFolder(); void Item(); void ItemCount();
    void Items(); void GetSelectionMarkedItem(); void GetFocusedItem(); void GetItemPosition(); void GetSpacing();
    void GetDefaultSpacing();
    [PreserveSig] int GetAutoArrange();
    void SelectItem(); void SelectAndPositionItems();
    // IFolderView2
    void SetGroupBy(); void GetGroupBy(); void SetViewProperty(); void GetViewProperty();
    void SetTileViewProperties(); void SetExtendedTileViewProperties(); void SetText();
    void SetCurrentFolderFlags(uint mask, uint flags);
    uint GetCurrentFolderFlags();
    int GetSortColumnCount();
    void SetSortColumns([In, MarshalAs(UnmanagedType.LPArray, SizeParamIndex = 1)] SortColumn[] columns, int count);
    void GetSortColumns([Out, MarshalAs(UnmanagedType.LPArray, SizeParamIndex = 1)] SortColumn[] columns, int count);
  }

  public static class Desktop {
    const uint FWF_AUTOARRANGE = 0x1;
    const int SORT_ASCENDING = 1;
    static readonly PropertyKey ItemNameDisplay = new PropertyKey {
      FormatId = new Guid("B725F130-47EF-101A-A5F1-02608C9EEBAC"), PropertyId = 10 };

    static IFolderView2 GetView() {
      Type shellWindowsType = Type.GetTypeFromCLSID(new Guid("9BA05972-F6A8-11CF-A442-00A0C90A8F39"));
      object shellWindows = Activator.CreateInstance(shellWindowsType);
      try {
        // FindWindowSW(CSIDL_DESKTOP, empty, SWC_DESKTOP, out hwnd, SWFO_NEEDDISPATCH)
        object[] args = { 0, null, 8, 0, 1 };
        var modifier = new ParameterModifier(5);
        modifier[0] = true; modifier[1] = true; modifier[3] = true;
        object dispatch = shellWindowsType.InvokeMember("FindWindowSW", BindingFlags.InvokeMethod, null,
          shellWindows, args, new[] { modifier }, null, null);
        if (dispatch == null) throw new InvalidOperationException("The desktop window is not available.");
        Guid topLevelBrowser = new Guid("4C96BE40-915C-11CF-99D3-00AA004AE837");
        Guid shellBrowserId = typeof(IShellBrowser).GUID;
        var browser = (IShellBrowser)((IServiceProvider)dispatch).QueryService(ref topLevelBrowser, ref shellBrowserId);
        return (IFolderView2)browser.QueryActiveShellView();
      } finally {
        Marshal.ReleaseComObject(shellWindows);
      }
    }

    public static bool IsAutoArrangedByName() {
      IFolderView2 view = GetView();
      if (view.GetAutoArrange() != 0) return false;
      int count = view.GetSortColumnCount();
      if (count < 1) return false;
      var columns = new SortColumn[count];
      view.GetSortColumns(columns, count);
      return columns[0].Key.FormatId == ItemNameDisplay.FormatId &&
        columns[0].Key.PropertyId == ItemNameDisplay.PropertyId &&
        columns[0].Direction == SORT_ASCENDING;
    }

    public static void AutoArrangeByName() {
      IFolderView2 view = GetView();
      view.SetCurrentFolderFlags(FWF_AUTOARRANGE, FWF_AUTOARRANGE);
      view.SetSortColumns(new[] { new SortColumn { Key = ItemNameDisplay, Direction = SORT_ASCENDING } }, 1);
      // Persist now so a forced Explorer restart does not discard the change.
      ((IShellView)view).SaveViewState();
    }
  }
}
'@
}
$desktopArranged = $null
for ($attempt = 0; $attempt -lt 20 -and $null -eq $desktopArranged; $attempt++) {
  try {
    $desktopArranged = [ChezmoiWindowsSettings.Desktop]::IsAutoArrangedByName()
  } catch {
    Start-Sleep -Milliseconds 500
  }
}
if ($null -eq $desktopArranged) {
  Write-Warning 'The desktop was not available, so desktop icons were not arranged.'
} elseif (-not $desktopArranged) {
  Write-Host 'Turning on desktop auto arrange, sorted by name'
  [ChezmoiWindowsSettings.Desktop]::AutoArrangeByName()
}
{{ end -}}
